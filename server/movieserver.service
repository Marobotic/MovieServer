[Unit]
Description=MovieServer (family media server)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/maro/Work/MovieServer/server
ExecStart=/home/maro/Work/MovieServer/server/movieserver
Restart=on-failure
RestartSec=3

# The server listens on :8080 for family devices on the LAN.
# Uncomment and adjust if you want it bound to a specific interface.
# Environment=MOVIESERVER=...

[Install]
WantedBy=multi-user.target